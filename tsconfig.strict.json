{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "baseUrl": "./src",
    "paths": {
      "base/*": ["./base/*"],
      "common/*": ["./common/*"],
      "dashboard/*": ["./routing/base/__strict_shims__/*"],
      "routing/*": ["./routing/*"],
      "src/*": ["./*"]
    }
  },
  "include": [
    "src/common/**/*",
    "src/routing/base/categories/**/*.ts",
    "src/routing/base/learnContent.ts",
    "src/routing/base/learningPaths.ts",
    "src/routing/base/routes.ts",
    "src/routing/base/routeTypes.ts",
    "src/routing/base/siteRegistry.ts",
    "src/routing/site/algo/components/Sorting/index.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "build"]
}
