{
  "name": "AlgoLens",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^9.106.0",
    "@react-three/fiber": "^8.16.7",
    "autosuggest-highlight": "^3.1.1",
    "bootstrap": "^5.0.2",
    "chart.js": "^4.4.3",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.24.10",
    "js-sorted-set": "^0.7.0",
    "mathjs": "^13.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^4.2.0",
    "react-router-dom": "^5.2.0",
    "react-window": "^1.8.10",
    "reactstrap": "^8.9.0",
    "serve": "^14.2.0",
    "styled-components": "^6.1.11",
    "three": "^0.165.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --quiet",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "serve -s build -l 3000",
    "deploy": "GITHUB_PAGES=true npm run build && gh-pages -d build",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ]
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.+(json|css|md)": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}
