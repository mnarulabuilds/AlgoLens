{
  "name": "AlgoLens",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "autosuggest-highlight": "^3.1.1",
    "chart.js": "^4.4.3",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.24.10",
    "js-sorted-set": "^0.7.0",
    "mathjs": "^13.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-color": "^2.19.3",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^4.2.0",
    "react-window": "^2.5.3",
    "sass": "^1.108.2",
    "serve": "^14.2.0",
    "styled-components": "^6.1.11",
    "three": "^0.165.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "serve out -l 3000",
    "build": "next build",
    "preview": "npm run start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"app/**/*.{js,jsx,ts,tsx}\" --quiet",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate:routes": "node scripts/validate-routes.mjs",
    "test:e2e": "playwright test",
    "serve": "serve out -l 3000",
    "deploy": "GITHUB_PAGES=true npm run build && gh-pages -d out",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ]
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.+(json|css|scss|md)": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.23.2",
    "gh-pages": "^5.0.0",
    "husky": "^6.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^10.5.4",
    "prettier": "2.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}
